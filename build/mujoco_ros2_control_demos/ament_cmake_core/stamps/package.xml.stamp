<?xml version="1.0"?>
<?xml-model
   href="http://download.ros.org/schema/package_format3.xsd"
   schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
 <name>mujoco_ros2_control_demos</name>
 <version>0.1.0</version>
 <description>MuJoCo ROS2 Control Demos with toe_arm simulation</description>

 <maintainer email="sangteak601@gmail.com">Sangtaek Lee</maintainer>

 <license>MIT</license>

 <author>Sangtaek Lee</author>

 <buildtool_depend>ament_cmake</buildtool_depend>
 <buildtool_depend>ament_cmake_python</buildtool_depend>

 <!-- 编译时依赖 -->
 <depend>rclcpp</depend>
 <depend>rclcpp_action</depend>
 <depend>std_msgs</depend>
 <depend>control_msgs</depend>
 <depend>joint_trajectory_controller</depend>
 <depend>velocity_controllers</depend>
 <depend>force_torque_sensor_broadcaster</depend>
 <depend>imu_sensor_broadcaster</depend>

 <!-- 运行时依赖 -->
 <exec_depend>rclpy</exec_depend>
 <!-- 移除重复的 std_msgs 和 control_msgs exec_depend -->
 <exec_depend>trajectory_msgs</exec_depend>
 <exec_depend>geometry_msgs</exec_depend>
 <exec_depend>sensor_msgs</exec_depend>

 <!-- ros2_control依赖 -->
 <exec_depend>controller_manager</exec_depend>
 <exec_depend>joint_state_broadcaster</exec_depend>
 <exec_depend>position_controllers</exec_depend>
 <exec_depend>effort_controllers</exec_depend>
 
 <!-- 机器人描述和状态发布 -->
 <exec_depend>robot_state_publisher</exec_depend>
 <exec_depend>joint_state_publisher</exec_depend>
 
 <!-- 可视化 -->
 <exec_depend>rviz2</exec_depend>
 
 <!-- 工具 -->
 <exec_depend>tf2_ros</exec_depend>
 <exec_depend>tf2_ros_py</exec_depend>
 
 <!-- MuJoCo ROS2 Control -->
 <exec_depend>mujoco_ros2_control</exec_depend>

 <test_depend>ament_lint_auto</test_depend>
 <test_depend>ament_cmake_clang_format</test_depend>
 <test_depend>ament_cmake_cppcheck</test_depend>
 <test_depend>ament_cmake_cpplint</test_depend>
 <test_depend>ament_cmake_lint_cmake</test_depend>
 <test_depend>ament_cmake_copyright</test_depend>

 <export>
   <build_type>ament_cmake</build_type>
 </export>
</package>